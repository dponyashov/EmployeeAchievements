# Игнорировать данные базы данных при сборке образов
var/db/postgresql
.git
node_modules
.env
# Исключаем локальные данные баз данных (главная причина вашей ошибки)
var/db/postgresql
var/

# Исключаем логи и временные файлы
*.log
.logs/
.tmp/

# Исключаем зависимости фронтенда (они должны ставиться ИЗНУТРИ Dockerfile)
**/node_modules
**/dist
**/.svelte-kit
**/.next

# Исключаем артефакты сборки Java (они должны собираться внутри Docker или копироваться точечно)
**/target
**/.gradle
**/build

# Исключаем папки систем контроля версий и настройки IDE
.git
.gitignore
.idea
.vscode

# Исключаем файлы окружения и конфигурации Docker
.env
docker-compose*.yml
Dockerfile
